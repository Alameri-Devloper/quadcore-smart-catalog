{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".next/integration-tests",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "noEmit": false,
    "isolatedModules": false,
    "incremental": false
  },
  "include": [
    "domains/catalog/infrastructure/**/*.ts",
    "domains/catalog/media/**/*.ts",
    "domains/catalog/product-entry/**/*.ts",
    "domains/catalog/reference-data/**/*.ts",
    "domains/catalog/query/**/*.ts",
    "domains/catalog/sharing/**/*.ts",
    "domains/catalog/repositories/**/*.ts",
    "domains/catalog/types/**/*.ts",
    "domains/identity/**/*.ts",
    "domains/inventory/**/*.ts",
    "domains/workspace/**/*.ts",
    "shared/audit/**/*.ts",
    "shared/domain/**/*.ts",
    "shared/infrastructure/**/*.ts"
  ]
}
